{
  "name": "ply-visualizer-engine",
  "version": "1.0.0",
  "description": "Shared visualization engine (parsers, renderer, controls) plus its standalone web host",
  "packageManager": "pnpm@10.32.1",
  "main": "src/main.ts",
  "scripts": {
    "build": "webpack --mode=production",
    "dev": "webpack serve --mode=development",
    "start": "webpack serve --mode=development --open",
    "test": "playwright test",
    "bench:backend": "node scripts/backend-benchmark.mjs",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/three": "^0.185.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "mini-css-extract-plugin": "^2.10.2",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "svelte-loader": "^3.2.4",
    "svelte-preprocess": "^6.0.5",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@sparkjsdev/spark": "^2.1.0",
    "js-yaml": "^5.2.3",
    "three": "^0.185.1"
  }
}
