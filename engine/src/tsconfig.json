{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    // "bundler" resolution reads package `exports` maps, which is the only
    // place three declares its WebGPU entry point — so `three/webgpu` types
    // resolve with no `paths` workaround. The old "node" resolution predates
    // exports maps, and along with `baseUrl` stops functioning in TS 7.
    "moduleResolution": "bundler",
    "strict": true,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.js"]
}
