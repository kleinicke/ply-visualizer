{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "declaration": false,
    "outDir": "./dist",
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "#registration-wasm-loader": ["./src/registration/wasmLoader.browser.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "test/**/*"],
  "extends": "../tsconfig.base.json"
}
