{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": {
        "owner": "webpack",
        "fileLocation": "absolute",
        "pattern": [
          {
            "regexp": "^\\[tsl\\] (ERROR|WARNING) in (.*)\\((\\d+),(\\d+)\\)$",
            "severity": 1,
            "file": 2,
            "line": 3,
            "column": 4
          },
          {
            "regexp": "^\\s*(TS\\d+:.*)$",
            "message": 1
          }
        ],
        "background": {
          "activeBegins": true,
          "beginsPattern": "^(asset |webpack is watching|\\[webpack-cli\\]|assets by )",
          "endsPattern": "^webpack \\d+\\.\\d+\\.\\d+ compiled"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": {
        "owner": "webpack",
        "fileLocation": "absolute",
        "pattern": [
          {
            "regexp": "^\\[tsl\\] (ERROR|WARNING) in (.*)\\((\\d+),(\\d+)\\)$",
            "severity": 1,
            "file": 2,
            "line": 3,
            "column": 4
          },
          {
            "regexp": "^\\s*(TS\\d+:.*)$",
            "message": 1
          }
        ]
      },
      "group": "build",
      "presentation": {
        "reveal": "never"
      }
    },
    {
      "type": "npm",
      "script": "dev",
      "path": "engine",
      "problemMatcher": [],
      "label": "npm: dev - engine",
      "detail": "webpack serve --mode=development"
    }
  ]
}
