{
  "compilerOptions": {
    "module": "commonjs",
    "outDir": "out",
    "sourceMap": true,
    "rootDir": ".",
    "types": ["node", "vscode"],
    "paths": {
      "#registration-wasm-loader": ["./engine/src/registration/wasmLoader.ts"]
    }
  },
  "include": ["src/**/*", "engine/src/parsers/**/*", "engine/src/interfaces.ts"],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "ui-tests",
    "engine/tests",
    "engine/playwright.config.ts"
  ],
  "extends": "./tsconfig.base.json"
}
