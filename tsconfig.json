{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "out",
    "lib": ["ES2020", "DOM"],
    "sourceMap": true,
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"],
    "forceConsistentCasingInFileNames": true,
    // Matches the webpack aliases: tsc compiles the extension host and the node
    // test suite, both of which want the CommonJS loader.
    "paths": {
      "#registration-wasm-loader": ["./engine/src/registration/wasmLoader.ts"]
    }
  },
  "include": ["src/**/*", "engine/src/parsers/**/*", "engine/src/interfaces.ts"],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "ui-tests",
    "engine/tests",
    "engine/playwright.config.ts"
  ]
}
